{
  "info": {
    "name": "Classroom Mock API",
    "description": "Start the server with npm start, then run requests in order. All changes live in memory. Change baseUrl for a different port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "4",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Reset sample data",
      "request": {
        "method": "POST",
        "header": [],
        "description": "Restore the three original users.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reset"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Check the server is running.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Read the list of users.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Search users",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Filter with a query parameter.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users?search=alex",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "search",
              "value": "alex"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get one user",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Read one user by its path parameter.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Create a user. Inspect Location. The test saves the returned ID.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Taylor Smith\",\n  \"email\": \"taylor@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get created user",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Read the newly created user.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Replace user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Both editable fields are required.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Taylor Replaced\",\n  \"email\": \"replaced@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update one field",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Change the name; email stays unchanged.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Taylor Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "description": "Delete the user. The response body is empty.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get deleted user",
      "request": {
        "method": "GET",
        "header": [],
        "description": "The deleted user now returns 404.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Inspect the validation error details.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Malformed JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "The missing closing brace causes a JSON syntax error.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Taylor\"",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Wrong content type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "description": "This endpoint expects application/json.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 415', function () { pm.response.to.have.status(415); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Unsupported method",
      "request": {
        "method": "DELETE",
        "header": [],
        "description": "Inspect the Allow response header.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 405', function () { pm.response.to.have.status(405); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Echo request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Inspect the method, headers, query, and body received.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/echo?lesson=http",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "echo"
          ],
          "query": [
            {
              "key": "lesson",
              "value": "http"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Hello students!\",\n  \"lesson\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Missing bearer token",
      "request": {
        "method": "GET",
        "header": [],
        "description": "This endpoint requires a bearer token.",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/protected",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "protected"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Valid bearer token",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Inspect the Authorization tab for the fixed classroom token.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "classroom-secret",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/protected",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "protected"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
